# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Uses the libvirt/KVM provider instead of VirtualBox. This box runs on top
# of an EC2 instance, which is itself already virtualized. VirtualBox needs
# direct hardware VT-x/AMD-V passthrough that it can't reliably get when
# nested inside another VM. KVM works instead, using EC2's nested
# virtualization support (see README "Step 1").

Vagrant.configure("2") do |config|
  # Generic box - built to work across providers (incl. libvirt).
  # Do NOT use "ubuntu/jammy64" here, that box is VirtualBox-only.
  config.vm.box = "generic/ubuntu2204"

  config.vm.hostname = "testbox"

  config.vm.provider "libvirt" do |lv|
    lv.driver = "kvm"
    lv.cpus = 4
    lv.memory = 4096
    lv.machine_virtual_size = 20 # GB disk
  end

  # --- Networking ---
  config.vm.network "forwarded_port", guest: 8080, host: 8080, host_ip: "0.0.0.0"


  # libvirt doesn't support VirtualBox-style shared folders.
  # rsync is one-way (host -> guest) and syncs on `vagrant up` / `vagrant
  # reload` / `vagrant rsync`. That's enough for a "deploy this repo" flow.
  config.vm.synced_folder ".", "/vagrant", type: "rsync",
    rsync__exclude: [".git/", "postgres_data/"]

  # Install Docker + Compose plugin inside the box.
  config.vm.provision "shell", path: "scripts/bootstrap.sh"

  # Pull images and bring the stack up every time the box boots/reloads.
  
  config.vm.provision "shell", run: "always", inline: <<-SHELL
    cd /vagrant
    su vagrant -c "docker compose pull"
    su vagrant -c "docker compose up -d"

    echo "Waiting for app1 to be healthy before running migrations..."
    for i in $(seq 1 30); do
      status=$(docker inspect --format='{{.State.Health.Status}}' student-api-1 2>/dev/null || echo "starting")
      if [ "$status" = "healthy" ]; then
        echo "app1 is healthy, running migrations"
        break
      fi
      echo "  app1 status: $status ($i/30)"
      sleep 3
    done

    su vagrant -c "docker compose exec -T app1 alembic upgrade head"
  SHELL
end
